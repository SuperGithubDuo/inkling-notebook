# Dependencies and build output
node_modules/
out/
dist/
/release/
# Second build used by the installer lifecycle test (release.yml)
/release-next/
# Built download site (scripts/site/build-site.mjs)
/_site/
*.tsbuildinfo

# Cloudflare Wrangler local state and secrets for the beta server
.wrangler/
.dev.vars
.dev.vars.*

# Test output
test-results/
coverage/

# Secrets and local configuration — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
# npm auth tokens
.npmrc
# Installers and update files belong on GitHub Releases, never in git
*.exe
*.dmg
*.blockmap
*.AppImage
latest*.yml

# Local notebook data (users' notes live in the OS app-data folder, but guard
# against data dirs created inside the repo during development)
Library/
inkling-data/
*.conflict-*.json
*.corrupt-*

# OS / editor noise
.DS_Store
Thumbs.db
*.log
.vscode/*
!.vscode/extensions.json
.idea/
